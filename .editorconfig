root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{bat,cmd}]
end_of_line = crlf

[frontend/**.{css,html,js,json,ts,tsx}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[backend/**.java]
indent_style = space
indent_size = 4

[backend/**.xml]
indent_style = tab

[justfile]
indent_style = space
indent_size = 4
